# Copy to .env and fill in. `openssl rand -hex 24` makes a good password/token.

# Required
DB_PASSWORD=
GRAFANA_DB_PASSWORD=          # read-only Postgres user for Grafana (grafana_ro)
API_TOKEN=                    # the token you enter in the Grout app; empty = API off

# Your timezone (IANA name). Decides what "today" is for streaks and reminders.
TZ=UTC

# Optional: Telegram bot. Leave TELEGRAM_TOKEN empty to run the API only.
# Token from @BotFather. Leave TELEGRAM_CHAT_ID empty at first, send /whoami to the bot,
# paste the number here, then `docker compose up -d` again.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Scheduled messages (check-in, nudges, weekly review) to Telegram. Set false when the
# app shows them as notifications instead. Commands keep working either way.
NOTIFY_TELEGRAM=true

# Optional: days you drive to work, e.g. mon,tue,thu,fri. On these, /screen in Telegram
# subtracts the usual navigation time (target drive_nav_min, 60). The app measures it instead.
DRIVE_DAYS=

# Optional: when the bot sends its scheduled messages (HH:MM in TZ)
# GOALS_TIME=07:00
# MOVE_REMINDER_TIME=11:00
# READ_REMINDER_TIME=19:20
# CHECKIN_TIME=21:30
# NUDGE_TIME=22:30
# TRAINING_CHECK_TIME=10:00
# REVIEW_TIME=19:00

# Optional: ports on the host
# API_HOST_PORT=8087          # the API listens on 127.0.0.1:<this>; point your reverse proxy at it
# PG_BIND=127.0.0.1           # Postgres for Grafana on <PG_BIND>:5433; use a VPN IP, never 0.0.0.0
