    {
      "id": 9,
      "type": "bargauge",
      "title": "Now reading",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "habits-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 10,
        "h": 7
      },
      "description": "Books in progress. Pages read before tracking started count toward progress.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "habits-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT title || '   p. ' || pages_read || ' / ' || total_pages\n         || '   since ' || to_char(started, 'DD Mon') AS \"Book\",\n       pct AS \"Progress\"\nFROM v_books WHERE finished IS NULL ORDER BY started DESC"
        }
      ],
      "fieldConfig": {
