  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current streak (days)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "habits-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "habits-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH g AS (SELECT day, day - (row_number() OVER (ORDER BY day))::int AS grp FROM checkins WHERE goals),\n     runs AS (SELECT count(*) AS n, max(day) AS last FROM g GROUP BY grp)\nSELECT max(current_streak) FILTER (WHERE habit = 'move')  AS \"Move\",\n       max(current_streak) FILTER (WHERE habit = 'read')  AS \"Read\",\n       max(current_streak) FILTER (WHERE habit = 'phone') AS \"Phone out\",\n       (SELECT COALESCE((SELECT n FROM runs WHERE last >= current_date - 1 ORDER BY last DESC LIMIT 1), 0)) AS \"Goals\",\n       max(current_streak) FILTER (WHERE habit = 'all')   AS \"All three\"\nFROM v_streaks"
        }
      ],
      "description": "Consecutive days at or above the daily floor. Today not logged yet does not break a streak.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
          "valueSize": 38
        },
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Best streak (days)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "habits-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "habits-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH g AS (SELECT day, day - (row_number() OVER (ORDER BY day))::int AS grp FROM checkins WHERE goals),\n     runs AS (SELECT count(*) AS n, max(day) AS last FROM g GROUP BY grp)\nSELECT max(best_streak) FILTER (WHERE habit = 'move')  AS \"Move\",\n       max(best_streak) FILTER (WHERE habit = 'read')  AS \"Read\",\n       max(best_streak) FILTER (WHERE habit = 'phone') AS \"Phone\",\n       (SELECT COALESCE(max(n), 0) FROM runs)          AS \"Goals\"\nFROM v_streaks"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "showPercentChange": false,
        "text": {
          "titleSize": 15,
