          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#e08a2b"
          },
          "displayName": "${__data.fields.Book}"
        },
        "overrides": []
      },
      "options": {
