    {
      "id": 10,
      "type": "table",
      "title": "Finished books",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "habits-pg"
      },
      "gridPos": {
        "x": 10,
        "y": 28,
        "w": 14,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "habits-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT title AS \"Book\",\n       to_char(finished, 'DD Mon YYYY') AS \"Finished\",\n       to_char(started, 'DD Mon YYYY')  AS \"Started\",\n       finished - started + 1          AS \"Days\",\n       total_pages                      AS \"Pages\"\nFROM v_books WHERE finished IS NOT NULL\nORDER BY finished DESC, id DESC"
        }
      ],
