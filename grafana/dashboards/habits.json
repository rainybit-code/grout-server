    {
      "id": 3,
      "type": "stat",
      "title": "Screen time, 7-day avg",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "habits-pg"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "habits-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(avg(screen_net_min)) AS \"Net of driving\"\nFROM v_daily WHERE day > current_date - 7 AND screen_min IS NOT NULL"
        }
      ],
      "description": "Phone screen time minus Google Maps while driving. Green at or under the target (180 min).",
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 181
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "auto",
        "showPercentChange": false,
        "text": {
          "titleSize": 14,
          "valueSize": 34
        },
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Daily habits",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "habits-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "habits-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT v.day::timestamptz AS time,\n       CASE WHEN c.goals THEN 2 WHEN NOT c.goals THEN 0 END AS \"3 goals written\",\n       v.move_lvl AS \"Move\",\n       v.read_lvl AS \"Read\",\n       CASE WHEN v.phone_out THEN 2 WHEN NOT v.phone_out THEN 0 END AS \"Phone out of bedroom\"\nFROM v_daily v LEFT JOIN checkins c USING (day)\nWHERE v.tracking AND $__timeFilter(v.day::timestamptz)\nORDER BY 1"
        }
      ],
      "description": "Floor = the minimum (2 min move, 10 pages). Full = a real session / 30 min reading. Phone: full = out of the bedroom. Blank = not logged.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "missed",
                  "color": "#c3c8cf",
                  "index": 0
                },
                "1": {
                  "text": "floor",
                  "color": "#9ccfa5",
                  "index": 1
                },
                "2": {
                  "text": "full",
                  "color": "#2e8b4e",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "#c3c8cf"
          },
          "custom": {
            "fillOpacity": 90,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": false,
        "rowHeight": 0.8,
        "alignValue": "center",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Screen time per day (net of driving)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "habits-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "habits-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT time, \"Net screen time\", \"7-day average\" FROM (\n  SELECT day::timestamptz AS time,\n         screen_net_min AS \"Net screen time\",\n         round(avg(screen_net_min) OVER (ORDER BY day ROWS BETWEEN 6 PRECEDING AND CURRENT ROW)) AS \"7-day average\"\n  FROM v_daily WHERE screen_min IS NOT NULL\n) s\nWHERE $__timeFilter(time)\nORDER BY 1"
        }
      ],
      "description": "Dashed line = target (180 min). Change it here and in the targets table when you lower it.",
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8ab8e6"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "barAlignment": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": true,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#7a828c",
                "value": 180
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "7-day average"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1f5fa8"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
